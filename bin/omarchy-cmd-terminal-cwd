#!/bin/bash

active_window=$(hyprctl activewindow -j)
active_class=$(jq -r '.class // empty' <<<"$active_window")
active_pid=$(jq -r '.pid // empty' <<<"$active_window")

case "$active_class" in
code)
	workspace_file="${XDG_RUNTIME_DIR:-/tmp}/vscode-focused-workspace-$UID"
	IFS= read -r cwd <"$workspace_file" 2>/dev/null || true
	;;
jetbrains-rider)
	while read -r child_pid; do
		child_exe=$(readlink -f "/proc/$child_pid/exe" 2>/dev/null)
		if grep -Fqsx "$child_exe" /etc/shells; then
			cwd=$(readlink -f "/proc/$child_pid/cwd" 2>/dev/null)
			break
		fi
	done < <(pgrep -P "$active_pid" | sort -rn)

	if [[ ! -d $cwd ]]; then
		while IFS= read -r -d '' project_path; do
			case "$project_path" in
			*.sln | *.slnx | *.csproj | *.fsproj | *.vbproj)
				if [[ -f $project_path ]]; then
					cwd=$(dirname -- "$project_path")
					break
				fi
				;;
			esac
		done <"/proc/$active_pid/cmdline"
	fi
	;;
esac

if [[ -d $cwd ]]; then
	printf '%s\n' "$cwd"
else
	exec /usr/share/omarchy/bin/omarchy-cmd-terminal-cwd
fi
